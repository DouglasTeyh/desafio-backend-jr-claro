{
  "title": "Desafio Claro - Dashboard",
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 38,
  "panels": [
    {
      "type": "stat",
      "title": "Total Cadastrado (Max 5)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [{ "expr": "pedidos_total", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Processando",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [{ "expr": "pedidos_por_status{status=\"EM_PROCESSAMENTO\"}", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Pausados",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [{ "expr": "pedidos_por_status{status=\"PAUSADO\"}", "refId": "A" }]
    },
    {
      "type": "bargauge",
      "title": "Pedidos por Status",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 6 },
      "targets": [{ "expr": "pedidos_por_status", "legendFormat": "{{status}}", "refId": "A" }]
    },
    {
      "type": "piechart",
      "title": "Capacidade (Limite de 5)",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "pedidos_total", "legendFormat": "Pedidos Cadastrados", "refId": "A" },
        { "expr": "5 - pedidos_total", "legendFormat": "Vagas Restantes", "refId": "B" }
      ]
    }
  ]
}
